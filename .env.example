# Application Settings
APP_NAME="AI Text Detection Engine"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Model Inference Settings
# Path to directory containing config.json, tokenizer.json, model.safetensors
MODEL_PATH="./saved_ai_detector"
MAX_SEQUENCE_LENGTH=512
DEVICE="auto"

# CORS Configuration (comma-separated list of allowed origins or *)
CORS_ORIGINS="*"
